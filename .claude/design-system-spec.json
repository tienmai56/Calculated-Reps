    "radius-sm": "10px",
    "radius-md": "14px",
    "radius-lg": "22px",
    "radius-xl": "28px",
    "radius-pill": "999px"
  },
  "shadow": {
    "shadow-none": "none",
    "shadow-hairline": "0 0 0 1px var(--border-subtle)",
    "shadow-card": "0 1px 0 rgba(29,27,24,.04), 0 6px 18px rgba(29,27,24,.06)",
    "shadow-float": "0 12px 32px rgba(29,27,24,.16), 0 0 0 1px var(--border-subtle)",
    "shadow-sheet": "0 -10px 40px rgba(29,27,24,.18)",
    "shadow-press": "0 3px 0 var(--accent-shade)",
    "ring-focus": "0 0 0 3px var(--accent-tint), 0 0 0 1.5px var(--border-focus)"
  },
  "motion": {
    "easing": {
      "ease-out": "cubic-bezier(.2,.8,.2,1)",
      "ease-in-out": "cubic-bezier(.65,0,.35,1)",
      "ease-bounce": "cubic-bezier(.34,1.56,.64,1)"
    },
    "duration": {
      "dur-fast": "140ms",
      "dur-base": "220ms",
      "dur-slow": "420ms"
    }
  },
  "components": {
    "Button": {
      "variants": [
        "primary",
        "secondary",
        "soft",
        "ghost",
        "inverse",
        "danger"
      ],
      "sizes": {
        "sm": 36,
        "md": 48,
        "lg": 56
      },
      "radius": "pill",
      "font": "display 700",
      "pressEdge": "3px accent-shade, sinks 2px on press"
    },
    "IconButton": {
      "variants": [
        "ghost",
        "filled",
        "accent",
        "overlay",
        "inverse"
      ],
      "defaultSize": 44,
      "press": "scale(.86) ease-bounce"
    },
    "Logo": {
      "variants": [
        "mark",
        "mono",
        "appIcon",
        "lockup",
        "lockupInverse"
      ],
      "defaultSize": 40,
      "minSize": 24,
      "tile": {
        "background": "sun-400",
        "radius": "22.5%"
      },
      "wordmarkSize": "0.6 × size",
      "gap": "0.3 × size"
    },
    "Input": {
      "minHeight": 50,
      "radius": "md",
      "border": "1.5px border-default",
      "focus": "border-focus + 4px accent-tint ring"
    },
    "Select": {
      "height": 50,
      "radius": "md"
    },
    "Checkbox": {
      "size": 24,
      "radius": 8
    },
    "Radio": {
      "size": 24
    },
    "Switch": {
      "track": [
        52,
        32
      ],
      "knob": 26
    },
    "Card": {
      "variants": [
        "default",
        "sunken",
        "outline"
      ],
      "radius": "lg",
      "shadow": "shadow-card"
    },
    "Badge": {
      "variants": [
        "neutral",
        "accent",
        "soft",
        "success",
        "warning",
        "danger",
        "info",
        "flame"
      ],
      "height": 24,
      "radius": "pill",
      "casing": "sentence"
    },
    "Tag": {
      "sizes": {
        "sm": 32,
        "md": 40
      },
      "selected": "ink-900 fill, paper text"
    },
    "Avatar": {
      "sizes": [
        24,
        28,
        30,
        34,
        40,
        44,
        52,
        60,
        80,
        104,
        108
      ],
      "fallback": "initials on friend-hue tint",
      "ring": "belt color"
    },
    "AvatarStack": {
      "overlap": "32% of size",
      "ringWidth": 2.5
    },
    "Belt": {
      "sizes": {
        "xs": 8,
        "sm": 12,
        "md": 16,
        "lg": 24
      },
      "stripes": "0–4",
      "bar": "black; red for black/coral/red belts"
    },
    "StreakBelt": {
      "segment": "1 calendar week (Mon–Sun)",
      "states": [
        "done",
        "missed",
        "pending-hatched"
      ],
      "hues": "friendHues"
    },
    "Tabs": {
      "variants": [
        "segmented",
        "underline"
      ]
    },
    "TabBar": {
      "height": 86,
      "items": [
        "Activity",
        "Training",
        "Friends",
        "Profile"
      ],
      "centerAction": "Plan a training (coral, 56×46 pill)"
    },
    "Dialog": {
      "variants": [
        "sheet",
        "modal"
      ],
      "sheetRadius": "xl top",
      "overlay": "surface-overlay"
    },
    "Toast": {
      "shape": "ink pill",
      "variants": [
        "default",
        "success",
        "danger",
        "streak",
        "friend"
      ],
      "autoDismissMs": 2600
    },
    "Tooltip": {
      "surface": "ink-900",
      "radius": 10
    }
  },
  "guardrails": {
    "forbidden": [
      "free-form posts",
      "public discovery",
      "group chat / DMs",
      "daily streaks",
      "leaderboards",
      "badges or milestones",
      "performance analytics",
      "custom avatar builder",
      "emoji in UI chrome",
      "gradients as decoration",
      "pure black text",
      "altered, redrawn or recolored logo"
    ],
    "rules": [
      "one primary button per screen",
      "coral is the only primary accent",
      "flame color only for streaks",
      "belt colors only to represent rank",
      "each friend keeps one hue everywhere",
      "posts originate only from completed sessions",
      "sentence case everywhere"
    ]
  },
  "icons": {
    "set": "Lucide",
    "version": "0.454.0",
    "license": "ISC",
    "strokeDefault": 2,
    "strokeButton": 2.25,
    "strokeActiveTab": 2.5,
    "sizes": [
      16,
      20,
      24
    ],
    "path": "assets/icons/"
  }
}
