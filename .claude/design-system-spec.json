      "clearSpace": "brow band height",
      "minSize": {
        "markHeightPx": 24,
        "lockupWidthPx": 120
      },
      "lockup": {
        "markToCapHeight": 1.7,
        "gapToMarkHeight": 0.3
      },
      "usage": {
        "onPaperWhiteSun": "mark",
        "onCoral": "markMono",
        "onInkOrPhotos": "appIcon tile"
      },
      "component": "design-system/components/core/Logo.jsx"
    }
  },
